# ============================================================
# MangPai 配置模板 —— 复制为 .env 后按需填写（.env 已入 .gitignore，永不入库）
# 全部配置均为环境变量；缺省时引擎按内置默认运行（DeepSeek 路径）。
# 隐私红线：本文件绝不填真实凭证，占位符一律为 your-xxx-here。
# ============================================================

# ---------- LLM 叙事层（可选；不配置 = 纯引擎模式，零外发） ----------

# 【必填·启用 LLM 时】API Key
# 回退链：MANGPAI_LLM_API_KEY → DEEPSEEK_API_KEY → env 文件（见 MANGPAI_LLM_ENV_FILE）
MANGPAI_LLM_API_KEY=your-api-key-here

# 【可选】OpenAI 兼容端点 URL
# 缺省 = https://api.deepseek.com/chat/completions（DeepSeek 官方）
# 本地 Ollama：http://localhost:11434/v1/chat/completions
# vLLM：http://<host>:8000/v1/chat/completions
# OpenAI：https://api.openai.com/v1/chat/completions
MANGPAI_LLM_BASE_URL=

# 【可选】模型名
# 缺省 = deepseek-flash（DeepSeek V4.1 正式 ID）
# Ollama 例：qwen2.5:14b；OpenAI 例：gpt-4o-mini
MANGPAI_LLM_MODEL=

# 【可选】provider 特有参数开关，缺省 = 1（开启）
# 1 = 请求体带 thinking + reasoning_effort 字段（DeepSeek V4 思考模式协议）
# 0 = 剔除这两个字段 —— 接严格 OpenAI 兼容服务（OpenAI/Ollama/vLLM/其他厂商）
#     遇 HTTP 400 unknown field 时必须设 0
MANGPAI_LLM_THINKING=0

# 【可选】思考强度，缺省 = low（仅 THINKING=1 时发出）
MANGPAI_LLM_REASONING_EFFORT=low

# 【可选】单次请求超时秒数，缺省 = 120（本地模型首载慢，建议调大如 300）
MANGPAI_LLM_TIMEOUT=120

# 【可选】失败重试次数，缺省 = 2（超时/5xx/网络错误重试，4xx 不重试）
MANGPAI_LLM_RETRIES=2

# 【可选】env 文件路径；设置后 key 只从该文件回退
# 缺省回退链 = ~/.env →（legacy 私有部署残留路径，后续主版本移除）
MANGPAI_LLM_ENV_FILE=

# 【可选】LLM 段总开关，缺省 = 1（开）
# 0 = 关闭 LLM 叙述，完全走引擎直出（纯引擎模式，零外发）
# 通用别名优先；飞书接入层旧名 FEISHU_USE_LLM 仍兼容
MANGPAI_USE_LLM=1

# ---------- 旧变量名（向后兼容，仍有效；新配置请用上面的 MANGPAI_LLM_*） ----------

# MANGPAI_LLM_API_KEY 的旧名，二者设其一即可（新名优先）
DEEPSEEK_API_KEY=

# MANGPAI_LLM_MODEL 的旧名（新名优先）
DEEPSEEK_MODEL=

# ---------- 飞书接入层（可选组件；不部署飞书机器人可整段留空） ----------
# 说明：飞书仅为可选接入层，核心流程（排盘 → 判定 → LLM 叙述）完全可脱离飞书运行。

# 【必填·部署飞书时】自建应用凭证与事件订阅 token
FEISHU_APP_ID=your-feishu-app-id-here
FEISHU_APP_SECRET=your-feishu-app-secret-here
FEISHU_VERIFICATION_TOKEN=your-verification-token-here

# 【可选】LLM 段开关旧名（MANGPAI_USE_LLM 优先；不设时默认开）
FEISHU_USE_LLM=

# 【可选】webhook 监听端口，缺省 = 9700
FEISHU_PORT=9700
